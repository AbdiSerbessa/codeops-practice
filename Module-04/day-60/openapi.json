{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/orders": {
      "get": {
        "operationId": "OrdersController_findAll_v1",
        "parameters": [
          {
            "name": "area",
            "required": false,
            "in": "query",
            "schema": {
              "example": "bole",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Orders returned successfully"
          },
          "400": {
            "description": "Invalid query parameters (400)"
          },
          "401": {
            "description": "Missing API key (401)"
          },
          "403": {
            "description": "Invalid API key (403)"
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "List orders optionally filtered by area",
        "tags": [
          "Orders"
        ]
      },
      "post": {
        "operationId": "OrdersController_create_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created (201)"
          },
          "400": {
            "description": "Validation failed (400)"
          },
          "401": {
            "description": "Missing API key (401)"
          },
          "403": {
            "description": "Invalid API key (403)"
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Place a new food order",
        "tags": [
          "Orders"
        ]
      }
    },
    "/api/v1/orders/slow": {
      "get": {
        "operationId": "OrdersController_getSlowReport_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Report completed"
          },
          "401": {
            "description": "Missing API key (401)"
          },
          "403": {
            "description": "Invalid API key (403)"
          },
          "408": {
            "description": "Request timed out (408)"
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Run delayed report endpoint to test 408 timeout",
        "tags": [
          "Orders"
        ]
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "operationId": "OrdersController_findOne_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order found"
          },
          "400": {
            "description": "Invalid order ID (400)"
          },
          "401": {
            "description": "Missing API key (401)"
          },
          "403": {
            "description": "Invalid API key (403)"
          },
          "404": {
            "description": "Order not found (404)"
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Get a single order by numeric ID",
        "tags": [
          "Orders"
        ]
      }
    }
  },
  "info": {
    "title": "Addis Eats Orders API",
    "description": "Order management API with structured JSON logging, request correlation IDs, API key protection, and interactive ordering via Swagger.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Orders",
      "description": "Order listing, lookup, creation, and timeout endpoints"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API key required for protected routes"
      }
    },
    "schemas": {
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "restaurant": {
            "type": "string",
            "example": "Yod Abyssinia"
          },
          "area": {
            "type": "string",
            "example": "bole"
          },
          "customerPhone": {
            "type": "string",
            "example": "+251911223344"
          },
          "totalSantim": {
            "type": "number",
            "minimum": 1,
            "example": 85000
          }
        },
        "required": [
          "restaurant",
          "area",
          "customerPhone",
          "totalSantim"
        ]
      }
    }
  }
}